# Copy this file to .env for local development.
# Paste your own API key locally. Never commit a populated .env file.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
MAX_UPLOAD_MB=50
AI_CONCURRENCY_LIMIT=3
IP_AI_GENERATION_LIMIT_PER_HOUR=25
DAILY_AI_GENERATION_LIMIT=100
AI_CALL_TIMEOUT_SECONDS=120
AI_RESPONSE_CACHE_TTL_SECONDS=1800
AI_RESPONSE_CACHE_MAX_ENTRIES=12
